# ==============================================================================
# ASTRA AI OPERATING SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and populate with your API credentials.
# NEVER commit .env or private keys to source control.

# ------------------------------------------------------------------------------
# 1. SERVER KERNEL CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8990
NODE_ENV=development
HOST=0.0.0.0
JWT_SECRET=your_jwt_secret_key_minimum_32_chars

# ------------------------------------------------------------------------------
# 2. OFFICIAL AI MODEL PROVIDERS (BACKEND SECURE)
# ------------------------------------------------------------------------------
# OpenAI (GPT-4o, GPT-4o-mini, o1, Realtime Audio API)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio / Gemini API (Gemini 1.5 Pro, Flash, Gemini 2.0)
# https://aistudio.google.com/
GEMINI_API_KEY=

# Groq Cloud (Ultra-low latency Llama 3.3 70B, Mixtral)
# https://console.groq.com/keys
GROQ_API_KEY=

# DeepSeek AI (DeepSeek-V3, DeepSeek-R1)
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Local Ollama / vLLM Endpoint (Offline & Air-gapped Operations)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. DATABASE & VECTOR STORAGE (SUPABASE)
# ------------------------------------------------------------------------------
# https://supabase.com/dashboard
SUPABASE_URL=https://hzvsrqhfurghzkfdpxlt.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 4. OFFICIAL THIRD-PARTY INTEGRATIONS & OAUTH
# ------------------------------------------------------------------------------
# GitHub Integration (REST API & Webhooks)
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Cloud OAuth & Workspace (Gmail, Calendar, Drive)
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8990/api/integrations/google/callback

# Vercel Deployment API
# https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Figma API
# https://www.figma.com/developers/api
FIGMA_TOKEN=

# Canva API
# https://www.canva.com/developers/
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Spotify Web API
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. VOICE & HARDWARE BRIDGE SETTINGS
# ------------------------------------------------------------------------------
ASTRA_WAKE_WORD="Hey Astra"
ASTRA_DEFAULT_VOICE="alloy"
ASTRA_PERMISSIONS_STRICT=true
ROBOTICS_SAFETY_INTERLOCK=true
